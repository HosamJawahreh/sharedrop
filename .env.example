# ShareDrop production environment — copy to hosting secrets / build env.
# Never commit real credentials or production secrets.

# --- Client (set at build time: npm run build) ---
# Required for HTTPS single-domain deployments (same host as the Node app).
# VITE_SIGNALING_URL=wss://your-domain.example

# Optional ICE servers (STUN / TURN / TURNS). JSON array — never commit real TURN secrets.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# --- Signaling server (runtime: npm start) ---
NODE_ENV=production
SHAREDROP_ENV=production

# Hosting platforms (e.g. MyInterServer) often assign PORT — used when SIGNALING_PORT is unset.
# PORT=3000

# Optional explicit signaling port (overrides PORT when set).
# SIGNALING_PORT=8787

SIGNALING_HOST=0.0.0.0

# Required in production — bare https origins for your deployed frontend (comma-separated).
SIGNALING_ALLOWED_ORIGINS=https://your-domain.example

# Optional
# SHAREDROP_VERSION=0.13.3
# SIGNALING_MAX_CONNECTIONS=1000
# SIGNALING_MAX_MESSAGES_PER_SECOND=30
# SIGNALING_MAX_MESSAGE_BYTES=20480
