# ShareDrop environment template — copy to `.env.local` / deployment secrets.
# Never commit real TURN credentials or production secrets.

# --- Client (Vite build) ---
# Production signaling must be WSS when the app is served over HTTPS.
# Explicit ws:// is rejected on HTTPS pages (mixed content).
# VITE_SIGNALING_URL=wss://signal.example.com

# ICE servers: STUN + optional TURN/TURNS. Placeholders only — never commit secrets.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"…","credential":"…"},{"urls":"turns:turn.example.com:5349","username":"…","credential":"…"}]

# Validation-only: force TURN relay. Leave unset in production (natural ICE = all).
# VITE_ICE_TRANSPORT_POLICY=relay

# --- Signaling server ---
# SIGNALING_HOST=0.0.0.0
# SIGNALING_PORT=8787

# Development default is `*` (open). Production MUST set explicit HTTPS origins:
# NODE_ENV=production
# SHAREDROP_ENV=production
# SIGNALING_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
# (never *; never `lan`; http:// origins are rejected in production)
# LAN development alternative: SIGNALING_ALLOWED_ORIGINS=lan

# Optional abuse / resource tuning
# SIGNALING_MAX_CONNECTIONS=1000
# SIGNALING_MAX_MESSAGES_PER_SECOND=30
# SIGNALING_MAX_MESSAGE_BYTES=20480

# Optional version string exposed on GET /health
# SHAREDROP_VERSION=0.11.0
